# Copie para .env. JWT_SECRET: chave aleatória com ao menos 32 caracteres.
# Gere uma com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
DATABASE_URL="file:./dev.db"
PORT=3000
# Em container use HOST=0.0.0.0; localmente mantenha 127.0.0.1.
HOST=127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5173
